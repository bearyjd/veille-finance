# Template for /etc/veille/env (root:root 0600). Every ${VAR:?} in
# deploy/compose.yml must be present; optional blocks may stay empty.
# Generate secrets with: openssl rand -hex 64

# Sure image override — pin by digest after validating a bump (optional).
#SURE_IMAGE=ghcr.io/we-promise/sure@sha256:…

# ── tenant: alpha ────────────────────────────────────────────────
ALPHA_POSTGRES_PASSWORD=
ALPHA_SECRET_KEY_BASE=
# read-scoped /api/v1 key of the Sure user veille connects as (ADR-001):
VEILLE_API_KEY_ALPHA=

# ── tenant: beta ─────────────────────────────────────────────────
BETA_POSTGRES_PASSWORD=
BETA_SECRET_KEY_BASE=
VEILLE_API_KEY_BETA=

# ── digest delivery (required for veille run) ────────────────────
VEILLE_SMTP_USERNAME=
VEILLE_SMTP_PASSWORD=

# ── optional LLM narration (PRP §8) ──────────────────────────────
#VEILLE_LLM_BASE_URL=
#VEILLE_LLM_API_KEY=
#VEILLE_LLM_MODEL=
